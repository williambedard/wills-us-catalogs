{%- comment -%}
Deposit Variant Picker Block
Allows selection of deposit product variants (payment options)
Can be added in Theme Editor under Product Information > Details
{%- endcomment -%}

<script src="{{ 'deposit-ultra-simple.js' | asset_url }}" defer></script>
<script src="{{ 'money-metafield-diagnostics.js' | asset_url }}" defer></script>

{% liquid
  assign product = product | default: closest.product
  if request.visual_preview_mode and product == blank
    assign product = collections.all.products.first
  endif
  
  comment
  # Get deposit product from block settings
  endcomment
  assign deposit_product = block.settings.deposit_product
  assign first_variant = product.selected_or_first_available_variant
  
  comment
  # Only show if product has "has_deposit_options" tag
  endcomment
  assign show_deposit_options = false
  if product.tags contains 'has_deposit_options'
    assign show_deposit_options = true
  endif
  
  comment
  # MONEY metafield calculation using JSON string parsing method
  endcomment
  assign initial_deposit = 0
  if show_deposit_options and first_variant
    
    comment
    # Extract numeric values using reliable JSON string manipulation
    endcomment
    assign fuel_pump_deposit = 0
    if first_variant.metafields.custom.deposit_for_high_pressure_fuel_pumps
      assign fuel_pump_json = first_variant.metafields.custom.deposit_for_high_pressure_fuel_pumps | json
      assign fuel_pump_deposit = fuel_pump_json | remove: '{"amount":"' | remove: '","currency_code":"USD"}' | times: 1
    endif
    
    assign injector_deposit = 0
    if first_variant.metafields.custom.deposit_for_injectors
      assign injector_json = first_variant.metafields.custom.deposit_for_injectors | json
      assign injector_deposit = injector_json | remove: '{"amount":"' | remove: '","currency_code":"USD"}' | times: 1
    endif
    
    assign fuel_line_deposit = 0
    if first_variant.metafields.custom.deposit_for_fuel_lines
      assign fuel_line_json = first_variant.metafields.custom.deposit_for_fuel_lines | json
      assign fuel_line_deposit = fuel_line_json | remove: '{"amount":"' | remove: '","currency_code":"USD"}' | times: 1
    endif
    
    comment
    # Calculate final deposit amount
    endcomment
    assign initial_deposit = fuel_pump_deposit | plus: injector_deposit | plus: fuel_line_deposit
  endif
%}

{% comment %} Only expose and show if product has deposit options {% endcomment %}
{% if show_deposit_options %}
<!-- DEBUG: Product has has_deposit_options tag -->
<!-- DEBUG: First variant ID: {{ first_variant.id }} -->

<!-- COMPREHENSIVE METAFIELD DEBUG OUTPUT -->
<!-- RAW METAFIELD VALUES: -->
<!-- Fuel pump raw: {{ first_variant.metafields.custom.deposit_for_high_pressure_fuel_pumps }} -->
<!-- Injector raw: {{ first_variant.metafields.custom.deposit_for_injectors }} -->  
<!-- Fuel line raw: {{ first_variant.metafields.custom.deposit_for_fuel_lines }} -->

<!-- APPROACH 1 - Direct .amount access: -->
<!-- Fuel pump v1: {{ fuel_pump_deposit_v1 }} -->
<!-- Injector v1: {{ injector_deposit_v1 }} -->
<!-- Fuel line v1: {{ fuel_line_deposit_v1 }} -->
<!-- Total v1: {{ initial_deposit_v1 }} -->

<!-- APPROACH 2 - String manipulation: -->
<!-- Fuel pump extracted: '{{ fuel_pump_amount_str }}' = {{ fuel_pump_deposit_v2 }} -->
<!-- Injector extracted: '{{ injector_amount_str }}' = {{ injector_deposit_v2 }} -->
<!-- Fuel line extracted: '{{ fuel_line_amount_str }}' = {{ fuel_line_deposit_v2 }} -->
<!-- Total v2: {{ initial_deposit_v2 }} -->

<!-- APPROACH 3 - Bracket notation: -->
<!-- Fuel pump v3: {{ fuel_pump_deposit_v3 }} -->
<!-- Injector v3: {{ injector_deposit_v3 }} -->
<!-- Fuel line v3: {{ fuel_line_deposit_v3 }} -->
<!-- Total v3: {{ initial_deposit_v3 }} -->

<!-- APPROACH 4 - Money filters: -->
<!-- Fuel pump v4: {{ fuel_pump_deposit_v4 }} -->
<!-- Injector v4: {{ injector_deposit_v4 }} -->
<!-- Fuel line v4: {{ fuel_line_deposit_v4 }} -->
<!-- Total v4: {{ initial_deposit_v4 }} -->

<!-- FINAL RESULTS: -->
<!-- Working approach: {{ working_approach }} -->
<!-- Final initial_deposit: {{ initial_deposit }} -->

<!-- DETAILED METAFIELD ANALYSIS -->
{% if first_variant.metafields.custom.deposit_for_injectors %}
  {% render 'money-metafield-debug', variant: first_variant, metafield: first_variant.metafields.custom.deposit_for_injectors %}
{% endif %}
<script>
  window.productMetafields = window.productMetafields || {};
  window.debugMetafields = window.debugMetafields || {};
  
  {% for variant in product.variants %}
    {% comment %} Apply same debugging approaches for JavaScript data {% endcomment %}
    {% assign v_fuel_pump_v1 = variant.metafields.custom.deposit_for_high_pressure_fuel_pumps.amount | default: 0 | times: 1 %}
    {% assign v_injector_v1 = variant.metafields.custom.deposit_for_injectors.amount | default: 0 | times: 1 %}
    {% assign v_fuel_line_v1 = variant.metafields.custom.deposit_for_fuel_lines.amount | default: 0 | times: 1 %}
    
    {% assign v_fuel_pump_raw = variant.metafields.custom.deposit_for_high_pressure_fuel_pumps | default: '{"amount":"0","currency_code":"USD"}' %}
    {% assign v_injector_raw = variant.metafields.custom.deposit_for_injectors | default: '{"amount":"0","currency_code":"USD"}' %}
    {% assign v_fuel_line_raw = variant.metafields.custom.deposit_for_fuel_lines | default: '{"amount":"0","currency_code":"USD"}' %}
    
    {% assign v_fuel_pump_str = v_fuel_pump_raw | remove: '{"amount":"' | remove: '","currency_code":"USD"}' | remove: '"' %}
    {% assign v_injector_str = v_injector_raw | remove: '{"amount":"' | remove: '","currency_code":"USD"}' | remove: '"' %}
    {% assign v_fuel_line_str = v_fuel_line_raw | remove: '{"amount":"' | remove: '","currency_code":"USD"}' | remove: '"' %}
    
    {% assign v_fuel_pump_v2 = v_fuel_pump_str | times: 1 | default: 0 %}
    {% assign v_injector_v2 = v_injector_str | times: 1 | default: 0 %}
    {% assign v_fuel_line_v2 = v_fuel_line_str | times: 1 | default: 0 %}
    
    {% comment %} Use working values - fallback logic {% endcomment %}
    {% if v_fuel_pump_v1 > 0 or v_injector_v1 > 0 or v_fuel_line_v1 > 0 %}
      window.productMetafields["{{ variant.id }}"] = {
        "fuel_pump_deposit": {{ v_fuel_pump_v1 }},
        "injector_deposit": {{ v_injector_v1 }},
        "fuel_line_deposit": {{ v_fuel_line_v1 }},
        "method": "v1_direct_amount"
      };
    {% elsif v_fuel_pump_v2 > 0 or v_injector_v2 > 0 or v_fuel_line_v2 > 0 %}
      window.productMetafields["{{ variant.id }}"] = {
        "fuel_pump_deposit": {{ v_fuel_pump_v2 }},
        "injector_deposit": {{ v_injector_v2 }},
        "fuel_line_deposit": {{ v_fuel_line_v2 }},
        "method": "v2_string_manipulation"
      };
    {% else %}
      window.productMetafields["{{ variant.id }}"] = {
        "fuel_pump_deposit": 0,
        "injector_deposit": 0,
        "fuel_line_deposit": 0,
        "method": "fallback_zeros"
      };
    {% endif %}
    
    {% comment %} Store debug data for analysis {% endcomment %}
    window.debugMetafields["{{ variant.id }}"] = {
      "raw_data": {
        "fuel_pump": {{ v_fuel_pump_raw | json }},
        "injector": {{ v_injector_raw | json }},
        "fuel_line": {{ v_fuel_line_raw | json }}
      },
      "extracted_strings": {
        "fuel_pump": "{{ v_fuel_pump_str }}",
        "injector": "{{ v_injector_str }}",
        "fuel_line": "{{ v_fuel_line_str }}"
      },
      "v1_amounts": {
        "fuel_pump": {{ v_fuel_pump_v1 }},
        "injector": {{ v_injector_v1 }},
        "fuel_line": {{ v_fuel_line_v1 }}
      },
      "v2_amounts": {
        "fuel_pump": {{ v_fuel_pump_v2 }},
        "injector": {{ v_injector_v2 }},
        "fuel_line": {{ v_fuel_line_v2 }}
      }
    };
  {% endfor %}
  
  // CONSOLE DEBUG HELPERS
  window.debugDepositMetafields = function() {
    console.group('🔍 DEPOSIT METAFIELD DEBUG ANALYSIS');
    
    console.log('📊 Window objects available:');
    console.log('- window.productMetafields:', !!window.productMetafields);
    console.log('- window.debugMetafields:', !!window.debugMetafields);
    
    if (window.debugMetafields) {
      Object.entries(window.debugMetafields).forEach(([variantId, data]) => {
        console.group(`🏷️ Variant ${variantId} Analysis`);
        
        console.log('📋 Raw metafield data:', data.raw_data);
        console.log('✂️ Extracted strings:', data.extracted_strings);
        console.log('🔢 V1 amounts (direct .amount):', data.v1_amounts);
        console.log('🔢 V2 amounts (string manipulation):', data.v2_amounts);
        
        const v1Total = (data.v1_amounts.fuel_pump || 0) + (data.v1_amounts.injector || 0) + (data.v1_amounts.fuel_line || 0);
        const v2Total = (data.v2_amounts.fuel_pump || 0) + (data.v2_amounts.injector || 0) + (data.v2_amounts.fuel_line || 0);
        
        console.log('💰 V1 Total:', v1Total);
        console.log('💰 V2 Total:', v2Total);
        
        if (window.productMetafields[variantId]) {
          console.log('✅ Final used values:', window.productMetafields[variantId]);
          console.log('🔧 Method used:', window.productMetafields[variantId].method);
        }
        
        console.groupEnd();
      });
    }
    
    if (window.productMetafields) {
      console.log('🎯 Final productMetafields structure:', window.productMetafields);
    }
    
    console.groupEnd();
  };
  
  // Auto-run debug on page load
  setTimeout(() => {
    if (typeof window.debugDepositMetafields === 'function') {
      window.debugDepositMetafields();
    }
  }, 1000);
</script>

<div class="deposit-variant-picker" {{ block.shopify_attributes }}>
  
  {% if block.settings.show_title %}
    <h3 class="deposit-title">{{ block.settings.deposit_title }}</h3>
  {% endif %}
  
  {% if block.settings.show_amount %}
    <p class="deposit-amount-display">
      {{ block.settings.amount_label }}: 
      <strong class="deposit-amount">${{ initial_deposit | money_without_currency }}</strong>
    </p>
  {% endif %}

  <div class="deposit-options">
    {% if block.settings.show_label %}
      <label for="deposit-variant-select">{{ block.settings.dropdown_label }}</label>
    {% endif %}
    
    <select id="deposit-variant-select" name="deposit_option" class="deposit-variant-dropdown" required>
      <option value="" disabled selected>{{ block.settings.placeholder_text | default: 'Please select a deposit option...' }}</option>
      {% if deposit_product %}
        {% for variant in deposit_product.variants %}
          <option value="{{ variant.title | downcase | replace: ' ', '_' }}" 
                  data-variant-id="{{ variant.id }}">
            {% case variant.title %}
              {% when 'Credit card on file' %}
                {{ block.settings.option1_label | default: variant.title }} - Hold $<span class="deposit-total-inline">{{ initial_deposit | money_without_currency }}</span>
              {% when 'Pay core deposit upfront' %}
                {{ block.settings.option2_label | default: variant.title }} - Pay $<span class="deposit-total-inline">{{ initial_deposit | money_without_currency }}</span>
              {% when 'Return cores in advance' %}
                {{ block.settings.option3_label | default: variant.title }} - No deposit required
              {% else %}
                {{ variant.title }}
            {% endcase %}
          </option>
        {% endfor %}
      {% else %}
        <option disabled>Deposit product not found</option>
      {% endif %}
    </select>
  </div>

  {% if block.settings.show_description %}
    <div class="deposit-description">
      <p id="deposit-option-description">{{ block.settings.default_description }}</p>
    </div>
  {% endif %}

</div>

<script>
// Handle deposit variant dropdown changes
document.addEventListener('DOMContentLoaded', function() {
  const dropdown = document.getElementById('deposit-variant-select');
  const description = document.getElementById('deposit-option-description');
  
  // Function to calculate current deposit amount
  function getCurrentDepositAmount() {
    const variantInput = document.querySelector('input[name="id"]');
    let totalDeposit = 0;
    
    if (variantInput && variantInput.value && window.productMetafields) {
      const variantId = variantInput.value;
      const metafields = window.productMetafields[variantId];
      if (metafields) {
        totalDeposit = (parseFloat(metafields.fuel_pump_deposit) || 0) + 
                      (parseFloat(metafields.injector_deposit) || 0) + 
                      (parseFloat(metafields.fuel_line_deposit) || 0);
      }
    }
    
    return totalDeposit;
  }
  
  // Function to update deposit amount display
  function updateDepositDisplay(amount) {
    const depositAmountEl = document.querySelector('.deposit-amount');
    if (depositAmountEl) {
      depositAmountEl.textContent = `$${amount.toFixed(2)}`;
    }
    
    // Update dropdown option amounts
    if (dropdown) {
      const options = dropdown.querySelectorAll('option[data-variant-id]');
      options.forEach(option => {
        const optionValue = option.value;
        const baseText = option.textContent.split(' - ')[0];
        
        if (optionValue === 'credit_card_on_file') {
          option.textContent = `${baseText} - Hold $${amount.toFixed(2)}`;
        } else if (optionValue === 'pay_core_deposit') {
          option.textContent = `${baseText} - Pay $${amount.toFixed(2)}`;
        }
      });
    }
  }
  
  // Set initial deposit amount on page load
  const initialAmount = getCurrentDepositAmount();
  if (initialAmount > 0) {
    updateDepositDisplay(initialAmount);
  }
  
  if (dropdown) {
    dropdown.addEventListener('change', function() {
      const selectedOption = this.value;
      
      // Mark as valid selection made
      this.classList.remove('invalid-selection');
      
      // Update deposit amount display
      const currentAmount = getCurrentDepositAmount();
      updateDepositDisplay(currentAmount);
      
      // Update description based on selection
      if (description) {
        switch(selectedOption) {
          case 'credit_card_on_file':
            description.textContent = '{{ block.settings.option1_description | default: "We will place a hold on your credit card for the deposit amount. The hold will be released when you return your old cores." }}';
            break;
          case 'pay_core_deposit_upfront':
            description.textContent = '{{ block.settings.option2_description | default: "Pay the deposit now. You will receive a refund when you return your old cores." }}';
            break;
          case 'return_cores_in_advance':
            description.textContent = '{{ block.settings.option3_description | default: "Return your old cores before ordering to avoid any deposit charges." }}';
            break;
        }
      }
      
      // Trigger form update for cart submission
      if (window.UltraSimpleDeposit) {
        // Update the payment option in the deposit calculator
        const event = new CustomEvent('deposit:option:change', {
          detail: { option: selectedOption }
        });
        document.dispatchEvent(event);
      }
    });
    
    // Trigger initial description update
    dropdown.dispatchEvent(new Event('change'));
  }
});
</script>
{% else %}
<!-- DEBUG: Product does NOT have has_deposit_options tag -->
<!-- DEBUG: Product ID: {{ product.id }}, Tags: {{ product.tags | join: ', ' }} -->
{% endif %}

{% style %}
  .deposit-variant-picker {
    margin: {{ block.settings.margin_top }}px 0 {{ block.settings.margin_bottom }}px 0;
    padding: {{ block.settings.padding }}px;
    background: {{ block.settings.background_color }};
    border-radius: {{ block.settings.border_radius }}px;
    {% if block.settings.show_border %}
      border: 1px solid {{ block.settings.border_color }};
    {% endif %}
  }

  .deposit-title {
    color: {{ block.settings.title_color }};
    margin-bottom: 12px;
    font-size: {{ block.settings.title_size }}px;
  }

  .deposit-amount-display {
    color: {{ block.settings.text_color }};
    margin-bottom: 16px;
  }

  .deposit-amount {
    color: {{ block.settings.amount_color }};
    font-size: 1.2em;
    font-weight: bold;
  }

  .deposit-options label {
    display: block;
    margin-bottom: 8px;
    color: {{ block.settings.text_color }};
    font-weight: 600;
  }

  .deposit-variant-dropdown {
    width: 100%;
    padding: 12px;
    border: 1px solid {{ block.settings.border_color }};
    border-radius: {{ block.settings.border_radius }}px;
    background: white;
    font-size: 16px;
    color: {{ block.settings.text_color }};
  }

  .deposit-variant-dropdown:focus {
    outline: 2px solid {{ block.settings.accent_color }};
    border-color: {{ block.settings.accent_color }};
  }

  .deposit-description {
    margin-top: 12px;
    padding: 12px;
    background: {{ block.settings.description_bg_color }};
    border-radius: {{ block.settings.border_radius }}px;
    color: {{ block.settings.text_color }};
    font-size: 14px;
    line-height: 1.4;
  }
{% endstyle %}

