{%- comment -%}
Deposit Variant Picker Block - Clean Production Version
Allows selection of deposit product variants (payment options)
Can be added in Theme Editor under Product Information > Details
Uses JSON string parsing for reliable MONEY metafield extraction
{%- endcomment -%}


{% liquid
  assign product = product | default: closest.product
  if request.visual_preview_mode and product == blank
    assign product = collections.all.products.first
  endif
  
  comment
  # Get deposit product from block settings
  endcomment
  assign deposit_product = block.settings.deposit_product
  assign first_variant = product.selected_or_first_available_variant
  
  comment
  # DEBUG: Check if deposit product is configured
  endcomment
  
  comment
  # Only show if product has "has_deposit_options" tag
  endcomment
  assign show_deposit_options = false
  if product.tags contains 'has_deposit_options'
    assign show_deposit_options = true
  endif
  
  comment
  # Get the first variant's quantity metafields and calculate total using unit prices (in cents)
  # Unit prices: Injectors $100 (10000 cents), Fuel Lines $100 (10000 cents), Fuel Pumps $200 (20000 cents)
  endcomment
  if show_deposit_options and first_variant
    assign num_injectors = first_variant.metafields.custom.number_of_injectors.value | default: 0
    assign num_fuel_lines = first_variant.metafields.custom.number_of_fuel_lines.value | default: 0
    assign num_fuel_pumps = first_variant.metafields.custom.number_of_high_pressure_fuel_pumps.value | default: 0
    
    assign injector_total = num_injectors | times: 10000
    assign fuel_line_total = num_fuel_lines | times: 10000
    assign fuel_pump_total = num_fuel_pumps | times: 20000
    
    assign initial_deposit = injector_total | plus: fuel_line_total | plus: fuel_pump_total
  endif
%}

{% comment %} Only expose and show if product has deposit options {% endcomment %}
{% if show_deposit_options %}
<!-- DEBUG: Deposit product from block settings: {{ deposit_product.id | default: 'NOT SET' }} -->
<!-- DEBUG: Deposit product handle: {{ deposit_product.handle | default: 'NOT SET' }} -->
<!-- DEBUG: Product has has_deposit_options tag -->
<!-- DEBUG: First variant ID: {{ first_variant.id }} -->
<!-- DEBUG: Number of injectors: {{ num_injectors }} -->
<!-- DEBUG: Number of fuel lines: {{ num_fuel_lines }} -->  
<!-- DEBUG: Number of fuel pumps: {{ num_fuel_pumps }} -->
<!-- DEBUG: Calculated initial_deposit: {{ initial_deposit }} -->
<!-- DEBUG: Individual amounts - Injectors: {{ injector_total }}, Fuel lines: {{ fuel_line_total }}, Fuel pumps: {{ fuel_pump_total }} -->
<script>
  window.productMetafields = window.productMetafields || {};
  {% for variant in product.variants %}
    {% comment %}DEBUG: Log what variant we're processing{% endcomment %}
    {% comment %}Extract only quantity values - calculations done in JavaScript{% endcomment %}
    {% assign num_inj = variant.metafields.custom.number_of_injectors.value | default: 0 %}
    {% assign num_fl = variant.metafields.custom.number_of_fuel_lines.value | default: 0 %}
    {% assign num_fp = variant.metafields.custom.number_of_high_pressure_fuel_pumps.value | default: 0 %}
    
    window.productMetafields["{{ variant.id }}"] = {
      "quantities": {
        "injectors": {{ num_inj }},
        "fuel_lines": {{ num_fl }},
        "fuel_pumps": {{ num_fp }}
      }
    };
  {% endfor %}
  
  // DEBUG: Log all metafields data (quantities only)
  console.log('Product metafields loaded:', window.productMetafields);
  
  // Store original fetch function to intercept cart API calls
  const originalFetch = window.fetch;
  
  // DEBUG: Log when our interceptor is loaded
  console.log('[INIT] Deposit fetch interceptor loaded');
  
  // Temporarily disable page redirects for debugging
  const originalLocation = window.location;
  Object.defineProperty(window, 'location', {
    value: {
      ...originalLocation,
      href: originalLocation.href,
      assign: function(url) {
        console.log('[REDIRECT-BLOCKED] Attempted redirect to:', url);
        if (url.includes('/cart')) {
          console.log('[REDIRECT-BLOCKED] Cart redirect prevented for debugging');
          return;
        }
        originalLocation.assign(url);
      },
      replace: function(url) {
        console.log('[REDIRECT-BLOCKED] Attempted replace to:', url);
        if (url.includes('/cart')) {
          console.log('[REDIRECT-BLOCKED] Cart redirect prevented for debugging');
          return;
        }
        originalLocation.replace(url);
      },
      set href(url) {
        console.log('[REDIRECT-BLOCKED] Attempted href set to:', url);
        if (url.includes('/cart')) {
          console.log('[REDIRECT-BLOCKED] Cart redirect prevented for debugging');
          return;
        }
        originalLocation.href = url;
      },
      get href() {
        return originalLocation.href;
      }
    },
    configurable: true
  });
  
  // Intercept fetch calls to detect when main products are added to cart
  window.fetch = function(...args) {
    const [resource, config] = args;
    
    // DEBUG: Log all fetch calls to see what's happening
    console.log('[FETCH] Intercepted fetch call:', resource, config?.method || 'GET');
    
    // Check if this is a cart/add.js call
    if (resource && resource.includes('/cart/add.js')) {
      console.log('[CART-ADD] Intercepting cart/add.js call!');
      
      // Call original fetch and handle the response
      return originalFetch.apply(this, args)
        .then(response => {
          console.log('[CART-ADD] Got response:', response.status, response.ok);
          
          // Clone response so it can be used by both our code and the theme
          const responseClone = response.clone();
          
          // If successful, check if we need to add deposit
          if (response.ok) {
            responseClone.json().then(cartData => {
              console.log('[CART-ADD] Cart response data:', cartData);
              
              // Check if current product has deposit requirements
              const depositPicker = document.querySelector('.deposit-variant-picker');
              const dropdown = document.getElementById('deposit-variant-select');
              
              console.log('[DEPOSIT-CHECK] Picker found:', !!depositPicker);
              console.log('[DEPOSIT-CHECK] Dropdown found:', !!dropdown);
              console.log('[DEPOSIT-CHECK] Dropdown value:', dropdown?.value);
              
              if (depositPicker && dropdown && dropdown.value) {
                const selectedOption = dropdown.value;
                const selectedOptionElement = dropdown.querySelector('option:checked');
                const depositVariantId = selectedOptionElement?.getAttribute('data-variant-id');
                
                console.log('[DEPOSIT-CHECK] Selected option:', selectedOption);
                console.log('[DEPOSIT-CHECK] Deposit variant ID:', depositVariantId);
                
                // Only add deposit for non-return options
                if (selectedOption !== 'return_cores_in_advance' && depositVariantId) {
                  // Get the variant ID from the added items
                  if (cartData.items && cartData.items.length > 0) {
                    const addedItem = cartData.items[cartData.items.length - 1]; // Get last added item
                    const variantId = addedItem.variant_id.toString();
                    const depositAmount = calculateDepositAmount(variantId);
                    
                    console.log('[DEPOSIT-CHECK] Added item variant ID:', variantId);
                    console.log('[DEPOSIT-CHECK] Calculated deposit amount:', depositAmount);
                    
                    if (depositAmount > 0) {
                      console.log('[DEPOSIT] TRIGGERING deposit addition!');
                      setTimeout(() => {
                        const bundleId = Date.now().toString();
                        addDepositToCart(depositVariantId, Math.ceil(depositAmount / 100), bundleId, depositAmount, selectedOption);
                      }, 200); // Small delay to ensure main product is processed
                    } else {
                      console.log('[DEPOSIT] No deposit needed - amount is 0');
                    }
                  } else {
                    console.log('[DEPOSIT] No items in cart response');
                  }
                } else {
                  console.log('[DEPOSIT] Skipping deposit addition - return option or missing variant ID');
                }
              } else {
                console.log('[DEPOSIT] Missing requirements for deposit addition');
              }
            }).catch(err => {
              console.warn('[CART-ADD] Could not parse cart response:', err);
            });
          }
          
          return response; // Return original response to theme
        });
    }
    
    // For all other fetch calls, use original fetch
    return originalFetch.apply(this, args);
  };
  
  // Function to add deposit product to cart using Shopify's AJAX Cart API
  async function addDepositToCart(depositVariantId, quantity, bundleId, totalAmount, depositOption) {
    try {
      console.log('[DEPOSIT] Attempting to add deposit:', {
        variantId: depositVariantId,
        quantity: quantity,
        bundleId: bundleId,
        totalAmount: totalAmount,
        depositOption: depositOption
      });

      const response = await originalFetch(window.Shopify?.routes?.root + 'cart/add.js', {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json',
          'X-Requested-With': 'XMLHttpRequest'
        },
        body: JSON.stringify({
          items: [{
            id: parseInt(depositVariantId),
            quantity: quantity,
            properties: {
              '_deposit_for': 'main_product',
              '_bundle_id': bundleId,
              '_is_deposit_product': 'true',
              'deposit_option': depositOption,
              '_calculated_amount': '$' + totalAmount.toFixed(2),
              '_unit_breakdown': quantity + ' units x $100.00 each'
            }
          }]
        })
      });
      
      if (!response.ok) {
        const errorText = await response.text();
        throw new Error(`HTTP ${response.status}: ${errorText}`);
      }
      
      const result = await response.json();
      console.log('[SUCCESS] Deposit product added to cart:', {
        variantId: depositVariantId,
        quantity: quantity,
        totalAmount: totalAmount,
        bundleId: bundleId,
        addedItems: result.items
      });
      
      // Trigger theme's cart update events manually if needed
      document.dispatchEvent(new CustomEvent('cart:update', {
        detail: {
          source: 'deposit-picker',
          depositAdded: true,
          bundleId: bundleId
        }
      }));
      
    } catch (error) {
      console.error('[ERROR] Failed to add deposit product to cart:', error);
      alert('Failed to add deposit to cart. Please try again.');
    }
  }
  
  
  // Function to update deposit amounts when variant changes
  function updateDepositAmountsForVariant(variantId) {
    const depositAmount = calculateDepositAmount(variantId);
    
    // Update the deposit amount display
    const depositAmountElement = document.querySelector('.deposit-amount');
    if (depositAmountElement) {
      depositAmountElement.setAttribute('data-initial-amount', depositAmount.toFixed(2));
      
      // Check current selected deposit option to show correct amount
      const dropdown = document.getElementById('deposit-variant-select');
      const selectedOption = dropdown?.value;
      
      switch(selectedOption) {
        case 'credit_card_on_file':
        case 'pay_core_deposit':
          depositAmountElement.textContent = '$' + depositAmount.toFixed(2);
          break;
        case 'return_cores_in_advance':
          depositAmountElement.textContent = '$0.00';
          break;
        default:
          depositAmountElement.textContent = '$' + depositAmount.toFixed(2);
          break;
      }
    }
    
    // Update inline amounts in dropdown options
    const inlineAmounts = document.querySelectorAll('.deposit-total-inline');
    inlineAmounts.forEach(element => {
      element.textContent = depositAmount.toFixed(2);
    });
    
    console.log(`Updated deposit display for variant ${variantId}: $${depositAmount.toFixed(2)}`);
  }
  
  // Listen for variant changes from the theme's variant picker
  document.addEventListener('variant:selected', function(event) {
    const selectedVariant = event.detail?.variant;
    if (selectedVariant && selectedVariant.id) {
      updateDepositAmountsForVariant(selectedVariant.id.toString());
    }
  });
  
  document.addEventListener('variant:update', function(event) {
    const selectedVariant = event.detail?.variant;
    if (selectedVariant && selectedVariant.id) {
      updateDepositAmountsForVariant(selectedVariant.id.toString());
    }
  });
</script>

<div class="deposit-variant-picker" {{ block.shopify_attributes }}>
  
  {% if block.settings.show_title %}
    <h3 class="deposit-title">{{ block.settings.deposit_title }}</h3>
  {% endif %}
  
  {% if block.settings.show_amount %}
    <p class="deposit-amount-display">
      {{ block.settings.amount_label }}: 
      <strong class="deposit-amount" data-initial-amount="{{ initial_deposit | money_without_currency }}">${{ initial_deposit | money_without_currency }}</strong>
    </p>
  {% endif %}


  <div class="deposit-options">
    {% if block.settings.show_label %}
      <label for="deposit-variant-select">{{ block.settings.dropdown_label }}</label>
    {% endif %}
    
    <select id="deposit-variant-select" name="deposit_option" class="deposit-variant-dropdown" required>
      <option value="" disabled selected>{{ block.settings.placeholder_text | default: 'Please select a deposit option...' }}</option>
      {% if deposit_product %}
        {% for variant in deposit_product.variants %}
          <option value="{{ variant.title | downcase | replace: ' ', '_' }}" 
                  data-variant-id="{{ variant.id }}">
            {% case variant.title %}
              {% when 'Credit Card on File' %}
                {{ block.settings.option1_label | default: variant.title }} - Hold $<span class="deposit-total-inline">{{ initial_deposit | money_without_currency }}</span>
              {% when 'Pay Core Deposit' %}
                {{ block.settings.option2_label | default: variant.title }} - Pay $<span class="deposit-total-inline">{{ initial_deposit | money_without_currency }}</span>
              {% when 'Return Cores in Advance' %}
                {{ block.settings.option3_label | default: variant.title }} - No deposit required
              {% else %}
                {{ variant.title }}
            {% endcase %}
          </option>
        {% endfor %}
      {% else %}
        <option disabled>Deposit product not found</option>
      {% endif %}
    </select>
  </div>

  {% if block.settings.show_description %}
    <div class="deposit-description">
      <p class="description-default">{{ block.settings.default_description }}</p>
      <p class="description-option" data-option="credit_card_on_file">
        {{ block.settings.option1_description | default: "We will place a hold on your credit card for the deposit amount. The hold will be released when you return your old cores." }}
      </p>
      <p class="description-option" data-option="pay_core_deposit">
        {{ block.settings.option2_description | default: "Pay the deposit now. You will receive a refund when you return your old cores." }}
      </p>
      <p class="description-option" data-option="return_cores_in_advance">
        {{ block.settings.option3_description | default: "Return your old cores before ordering to avoid any deposit charges." }}
      </p>
    </div>
  {% endif %}

</div>

<script>
document.addEventListener('DOMContentLoaded', function() {
  const dropdown = document.getElementById('deposit-variant-select');
  const depositPicker = document.querySelector('.deposit-variant-picker');
  
  // Find all product forms on the page
  const productForms = document.querySelectorAll('product-form');
  
  // Function to disable/enable add-to-cart buttons
  function updateAddToCartButtons(enable) {
    productForms.forEach(form => {
      const addToCartContainer = form.querySelector('[ref="addToCartButtonContainer"]');
      if (addToCartContainer && typeof addToCartContainer.disable === 'function') {
        if (enable) {
          addToCartContainer.enable();
        } else {
          addToCartContainer.disable();
        }
      }
    });
  }
  
  // Disable buttons on page load if deposit picker is present
  if (dropdown && document.querySelector('.deposit-variant-picker')) {
    updateAddToCartButtons(false);
  }
  
  // Handle deposit option selection
  if (dropdown) {
    dropdown.addEventListener('change', function() {
      const selectedOption = this.value;
      const selectedOptionElement = this.querySelector('option:checked');
      const depositVariantId = selectedOptionElement?.getAttribute('data-variant-id');
      
      // DEBUG: Log selected deposit variant
      console.log('[DEPOSIT] Option selected:', {
        option: selectedOption,
        variantId: depositVariantId,
        variantTitle: selectedOptionElement?.textContent?.trim()
      });
      
      this.classList.remove('invalid-selection');
      
      // Enable/disable add-to-cart buttons based on selection
      updateAddToCartButtons(!!selectedOption);
      
      // Update deposit amount display based on selection
      const depositAmountElement = document.querySelector('.deposit-amount');
      if (depositAmountElement) {
        const initialAmount = depositAmountElement.getAttribute('data-initial-amount');
        
        switch(selectedOption) {
          case 'credit_card_on_file':
          case 'pay_core_deposit':
            depositAmountElement.textContent = '$' + initialAmount;
            break;
          case 'return_cores_in_advance':
            depositAmountElement.textContent = '$0.00';
            break;
          default:
            // Reset to initial amount for unselected state
            depositAmountElement.textContent = '$' + initialAmount;
            break;
        }
      }
      
      // Update data attribute for CSS-based description display
      if (depositPicker) {
        if (selectedOption) {
          depositPicker.setAttribute('data-selected', selectedOption);
        } else {
          depositPicker.removeAttribute('data-selected');
        }
      }
    });
    
    // Only trigger initial change event if there's a selected value
    if (dropdown.value) {
      dropdown.dispatchEvent(new Event('change'));
    }
  }

  // Validate deposit selection before form submission
  const productFormElements = document.querySelectorAll('product-form form[action*="/cart/add"]');
  
  productFormElements.forEach(form => {
    form.addEventListener('submit', function(e) {
      // Only validate if deposit picker is present
      const depositPicker = document.querySelector('.deposit-variant-picker');
      if (!depositPicker) return; // No deposit picker, proceed normally
      
      // Validate deposit selection is required
      const selectedDepositOption = dropdown?.value;
      if (!selectedDepositOption) {
        e.preventDefault();
        dropdown?.classList.add('invalid-selection');
        dropdown?.focus();
        alert('Please select a deposit option before adding to cart.');
        return false;
      }
      
      // Let the theme handle cart addition normally
      console.log('[NORMAL] Form validation passed, letting theme handle cart addition');
    });
  });
  
  // Function to calculate deposit amount from quantities only
  // Unit prices: Injectors $100, Fuel Lines $100, Fuel Pumps $200
  function calculateDepositAmount(mainVariantId) {
    console.log('[CALC] Calculating deposit for variant:', mainVariantId);
    console.log('[CALC] Available metafields:', window.productMetafields);
    
    const variantMetafields = window.productMetafields?.[mainVariantId];
    if (!variantMetafields || !variantMetafields.quantities) {
      console.log('[CALC] No metafields found for variant:', mainVariantId);
      return 0;
    }
    
    const quantities = variantMetafields.quantities;
    console.log('[CALC] Found quantities:', quantities);
    
    // Calculate deposits from quantities using unit prices
    const injectorDeposit = (quantities.injectors || 0) * 100;
    const fuelLineDeposit = (quantities.fuel_lines || 0) * 100;
    const fuelPumpDeposit = (quantities.fuel_pumps || 0) * 200;
    
    const totalDeposit = injectorDeposit + fuelLineDeposit + fuelPumpDeposit;
    
    console.log(`[CALC] Deposit calculation for variant ${mainVariantId}:`, {
      quantities,
      unitPrices: { injectors: 100, fuel_lines: 100, fuel_pumps: 200 },
      deposits: { injectorDeposit, fuelLineDeposit, fuelPumpDeposit },
      totalDeposit
    });
    
    return totalDeposit;
  }

});
</script>
{% else %}
<!-- DEBUG: Product does NOT have has_deposit_options tag -->
<!-- DEBUG: Product ID: {{ product.id }}, Tags: {{ product.tags | join: ', ' }} -->
{% endif %}

{% style %}
  .deposit-variant-picker {
    margin: {{ block.settings.margin_top }}px 0 {{ block.settings.margin_bottom }}px 0;
    padding: {{ block.settings.padding }}px;
    background: {{ block.settings.background_color }};
    border-radius: {{ block.settings.border_radius }}px;
    {% if block.settings.show_border %}
      border: 1px solid {{ block.settings.border_color }};
    {% endif %}
  }

  .deposit-title {
    color: {{ block.settings.title_color }};
    margin-bottom: 12px;
    font-size: {{ block.settings.title_size }}px;
  }

  .deposit-amount-display {
    color: {{ block.settings.text_color }};
    margin-bottom: 16px;
  }

  .deposit-amount {
    color: {{ block.settings.amount_color }};
    font-size: 1.2em;
    font-weight: bold;
  }

  .deposit-options label {
    display: block;
    margin-bottom: 8px;
    color: {{ block.settings.text_color }};
    font-weight: 600;
  }

  .deposit-variant-dropdown {
    width: 100%;
    padding: 12px;
    border: 1px solid {{ block.settings.border_color }};
    border-radius: {{ block.settings.border_radius }}px;
    background: white;
    font-size: 16px;
    color: {{ block.settings.text_color }};
  }

  .deposit-variant-dropdown:focus {
    outline: 2px solid {{ block.settings.accent_color }};
    border-color: {{ block.settings.accent_color }};
  }

  .deposit-variant-dropdown.invalid-selection {
    border-color: #dc2626;
    background-color: #fef2f2;
  }

  .deposit-description {
    margin-top: 12px;
    padding: 12px;
    background: {{ block.settings.description_bg_color }};
    border-radius: {{ block.settings.border_radius }}px;
    color: {{ block.settings.text_color }};
    font-size: 14px;
    line-height: 1.4;
  }

  .deposit-description p {
    margin: 0;
  }

  /* Hide all descriptions by default */
  .description-option {
    display: none;
  }

  /* Show default description initially */
  .description-default {
    display: block;
  }

  /* Show specific descriptions based on dropdown selection */
  .deposit-variant-picker[data-selected="credit_card_on_file"] .description-option[data-option="credit_card_on_file"],
  .deposit-variant-picker[data-selected="pay_core_deposit"] .description-option[data-option="pay_core_deposit"],
  .deposit-variant-picker[data-selected="return_cores_in_advance"] .description-option[data-option="return_cores_in_advance"] {
    display: block;
  }

  /* Hide default when option is selected */
  .deposit-variant-picker[data-selected="credit_card_on_file"] .description-default,
  .deposit-variant-picker[data-selected="pay_core_deposit"] .description-default,
  .deposit-variant-picker[data-selected="return_cores_in_advance"] .description-default {
    display: none;
  }
{% endstyle %}

{% schema %}
{
  "name": "Deposit Variant Picker",
  "settings": [
    {
      "type": "paragraph",
      "content": "Shows deposit payment options for products with 'has_deposit_options' tag"
    },
    {
      "type": "product",
      "id": "deposit_product",
      "label": "Deposit Product",
      "info": "Select the product containing deposit variants (e.g., credit card hold, pay now, return first)"
    },
    {
      "type": "header",
      "content": "Display Options"
    },
    {
      "type": "checkbox",
      "id": "show_title",
      "label": "Show title",
      "default": true
    },
    {
      "type": "text",
      "id": "deposit_title",
      "label": "Title",
      "default": "Core Deposit Required"
    },
    {
      "type": "checkbox",
      "id": "show_amount",
      "label": "Show deposit amount",
      "default": true
    },
    {
      "type": "text",
      "id": "amount_label",
      "label": "Amount label",
      "default": "Deposit Amount"
    },
    {
      "type": "checkbox",
      "id": "show_label",
      "label": "Show dropdown label",
      "default": true
    },
    {
      "type": "text",
      "id": "dropdown_label",
      "label": "Dropdown label",
      "default": "Choose your deposit option:"
    },
    {
      "type": "text",
      "id": "placeholder_text",
      "label": "Dropdown placeholder",
      "default": "Please select a deposit option..."
    },
    {
      "type": "checkbox",
      "id": "show_description",
      "label": "Show option descriptions",
      "default": true
    },
    {
      "type": "text",
      "id": "default_description",
      "label": "Default description",
      "default": "Select an option above to see details."
    },
    {
      "type": "header",
      "content": "Deposit Options"
    },
    {
      "type": "text",
      "id": "option1_label",
      "label": "Credit Card Option Label",
      "default": "Credit Card Hold"
    },
    {
      "type": "textarea",
      "id": "option1_description",
      "label": "Credit Card Option Description",
      "default": "We will place a hold on your credit card for the deposit amount. The hold will be released when you return your old cores."
    },
    {
      "type": "text",
      "id": "option2_label",
      "label": "Pay Deposit Option Label",
      "default": "Pay Deposit Now"
    },
    {
      "type": "textarea",
      "id": "option2_description",
      "label": "Pay Deposit Option Description",
      "default": "Pay the deposit now. You will receive a refund when you return your old cores."
    },
    {
      "type": "text",
      "id": "option3_label",
      "label": "Return First Option Label",
      "default": "Return Cores First"
    },
    {
      "type": "textarea",
      "id": "option3_description",
      "label": "Return First Option Description",
      "default": "Return your old cores before ordering to avoid any deposit charges."
    },
    {
      "type": "header",
      "content": "Styling"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background Color",
      "default": "#f9f9f9"
    },
    {
      "type": "color",
      "id": "title_color",
      "label": "Title Color",
      "default": "#333333"
    },
    {
      "type": "range",
      "id": "title_size",
