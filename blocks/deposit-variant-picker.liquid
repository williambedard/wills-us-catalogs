{%- comment -%}
Deposit Variant Picker Block - Clean Production Version
Allows selection of deposit product variants (payment options)
Can be added in Theme Editor under Product Information > Details
Uses JSON string parsing for reliable MONEY metafield extraction
{%- endcomment -%}


{% liquid
  assign product = product | default: closest.product
  if request.visual_preview_mode and product == blank
    assign product = collections.all.products.first
  endif
  
  comment
  # Get deposit product from block settings
  endcomment
  assign deposit_product = block.settings.deposit_product
  assign first_variant = product.selected_or_first_available_variant
  
  comment
  # Only show if product has "has_deposit_options" tag
  endcomment
  assign show_deposit_options = false
  if product.tags contains 'has_deposit_options'
    assign show_deposit_options = true
  endif
  
  comment
  # Get the first variant's quantity metafields (Integer type) and calculate total deposit
  endcomment
  if show_deposit_options and first_variant
    assign num_fuel_pumps = first_variant.metafields.custom.number_of_high_pressure_fuel_pumps | default: 0
    assign num_injectors = first_variant.metafields.custom.number_of_injectors | default: 0
    assign num_fuel_lines = first_variant.metafields.custom.number_of_fuel_lines | default: 0
    
    comment
    # Calculate deposit amounts: injectors × $100, fuel pumps × $200, fuel lines × $100
    # Result will be in cents for proper Money formatting
    endcomment
    assign fuel_pump_deposit = num_fuel_pumps | times: 20000
    assign injector_deposit = num_injectors | times: 10000
    assign fuel_line_deposit = num_fuel_lines | times: 10000
    assign initial_deposit = fuel_pump_deposit | plus: injector_deposit | plus: fuel_line_deposit
  endif
%}

{% comment %} Only expose and show if product has deposit options {% endcomment %}
{% if show_deposit_options %}
<!-- DEBUG: Product has has_deposit_options tag -->
<!-- DEBUG: First variant ID: {{ first_variant.id }} -->
<!-- DEBUG: Number of fuel pumps: {{ first_variant.metafields.custom.number_of_high_pressure_fuel_pumps }} -->
<!-- DEBUG: Number of injectors: {{ first_variant.metafields.custom.number_of_injectors }} -->  
<!-- DEBUG: Number of fuel lines: {{ first_variant.metafields.custom.number_of_fuel_lines }} -->
<!-- DEBUG: Calculated initial_deposit: {{ initial_deposit }} -->
<!-- DEBUG: Individual amounts - Fuel pump: {{ fuel_pump_deposit }}, Injector: {{ injector_deposit }}, Fuel line: {{ fuel_line_deposit }} -->
<script>
  window.productMetafields = window.productMetafields || {};
  {% for variant in product.variants %}
    {% comment %}DEBUG: Log what variant we're processing{% endcomment %}
    {% comment %}Extract quantity values from Integer metafields{% endcomment %}
    {% assign fp_qty = variant.metafields.custom.number_of_high_pressure_fuel_pumps | default: 0 %}
    {% assign inj_qty = variant.metafields.custom.number_of_injectors | default: 0 %}
    {% assign fl_qty = variant.metafields.custom.number_of_fuel_lines | default: 0 %}
    
    window.productMetafields["{{ variant.id }}"] = {
      "fuel_pump_quantity": {{ fp_qty }},
      "injector_quantity": {{ inj_qty }},
      "fuel_line_quantity": {{ fl_qty }}
    };
  {% endfor %}
  
  // DEBUG: Log all metafields data
  console.log('Product metafields loaded:', window.productMetafields);
</script>

<div class="deposit-variant-picker" {{ block.shopify_attributes }}>
  
  {% if block.settings.show_title %}
    <h3 class="deposit-title">{{ block.settings.deposit_title }}</h3>
  {% endif %}
  
  {% if block.settings.show_amount %}
    <p class="deposit-amount-display">
      {{ block.settings.amount_label }}: 
      <strong class="deposit-amount" data-initial-amount="{{ initial_deposit | money_without_currency }}">${{ initial_deposit | money_without_currency }}</strong>
    </p>
  {% endif %}


  <div class="deposit-options">
    {% if block.settings.show_label %}
      <label for="deposit-variant-select">{{ block.settings.dropdown_label }}</label>
    {% endif %}
    
    <select id="deposit-variant-select" name="deposit_option" class="deposit-variant-dropdown" required>
      <option value="" disabled selected>{{ block.settings.placeholder_text | default: 'Please select a deposit option...' }}</option>
      {% if deposit_product %}
        {% for variant in deposit_product.variants %}
          <option value="{{ variant.title | downcase | replace: ' ', '_' }}" 
                  data-variant-id="{{ variant.id }}">
            {% case variant.title %}
              {% when 'Credit card on file' %}
                {{ block.settings.option1_label | default: variant.title }} - Hold $<span class="deposit-total-inline">{{ initial_deposit | money_without_currency }}</span>
              {% when 'Pay core deposit upfront' %}
                {{ block.settings.option2_label | default: variant.title }} - Pay $<span class="deposit-total-inline">{{ initial_deposit | money_without_currency }}</span>
              {% when 'Return cores in advance' %}
                {{ block.settings.option3_label | default: variant.title }} - No deposit required
              {% else %}
                {{ variant.title }}
            {% endcase %}
          </option>
        {% endfor %}
      {% else %}
        <option disabled>Deposit product not found</option>
      {% endif %}
    </select>
  </div>

  {% if block.settings.show_description %}
    <div class="deposit-description">
      <p class="description-default">{{ block.settings.default_description }}</p>
      <p class="description-option" data-option="credit_card_on_file">
        {{ block.settings.option1_description | default: "We will place a hold on your credit card for the deposit amount. The hold will be released when you return your old cores." }}
      </p>
      <p class="description-option" data-option="pay_core_deposit">
        {{ block.settings.option2_description | default: "Pay the deposit now. You will receive a refund when you return your old cores." }}
      </p>
      <p class="description-option" data-option="return_cores_in_advance">
        {{ block.settings.option3_description | default: "Return your old cores before ordering to avoid any deposit charges." }}
      </p>
    </div>
  {% endif %}

</div>

<script>
document.addEventListener('DOMContentLoaded', function() {
  const dropdown = document.getElementById('deposit-variant-select');
  const depositPicker = document.querySelector('.deposit-variant-picker');
  
  // Find all product forms on the page
  const productForms = document.querySelectorAll('product-form');
  
  // Function to disable/enable add-to-cart buttons
  function updateAddToCartButtons(enable) {
    productForms.forEach(form => {
      const addToCartContainer = form.querySelector('[ref="addToCartButtonContainer"]');
      if (addToCartContainer && typeof addToCartContainer.disable === 'function') {
        if (enable) {
          addToCartContainer.enable();
        } else {
          addToCartContainer.disable();
        }
      }
    });
  }
  
  // Disable buttons on page load if deposit picker is present
  if (dropdown && document.querySelector('.deposit-variant-picker')) {
    updateAddToCartButtons(false);
  }
  
  // Handle deposit option selection
  if (dropdown) {
    dropdown.addEventListener('change', function() {
      const selectedOption = this.value;
      
      
      this.classList.remove('invalid-selection');
      
      // Enable/disable add-to-cart buttons based on selection
      updateAddToCartButtons(!!selectedOption);
      
      // Update deposit amount display based on selection
      const depositAmountElement = document.querySelector('.deposit-amount');
      if (depositAmountElement) {
        const initialAmount = depositAmountElement.getAttribute('data-initial-amount');
        
        switch(selectedOption) {
          case 'credit_card_on_file':
          case 'pay_core_deposit':
            depositAmountElement.textContent = '$' + initialAmount;
            break;
          case 'return_cores_in_advance':
            depositAmountElement.textContent = '$0.00';
            break;
          default:
            // Reset to initial amount for unselected state
            depositAmountElement.textContent = '$' + initialAmount;
            break;
        }
      }
      
      // Update data attribute for CSS-based description display
      if (depositPicker) {
        if (selectedOption) {
          depositPicker.setAttribute('data-selected', selectedOption);
        } else {
          depositPicker.removeAttribute('data-selected');
        }
      }
    });
    
    // Only trigger initial change event if there's a selected value
    if (dropdown.value) {
      dropdown.dispatchEvent(new Event('change'));
    }
  }

  // Handle form submission to add deposit product when needed
  const productFormElements = document.querySelectorAll('product-form form[action*="/cart/add"]');
  
  productFormElements.forEach(form => {
    form.addEventListener('submit', async function(e) {
      // Only validate if deposit picker is present
      const depositPicker = document.querySelector('.deposit-variant-picker');
      if (!depositPicker) return; // No deposit picker, proceed normally
      
      // Validate deposit selection is required
      const selectedDepositOption = dropdown?.value;
      if (!selectedDepositOption) {
        e.preventDefault();
        dropdown?.classList.add('invalid-selection');
        dropdown?.focus();
        alert('Please select a deposit option before adding to cart.');
        return false;
      }
      
      // If deposit is required, add deposit product after main product
      if (selectedDepositOption !== 'return_cores_in_advance') {
        e.preventDefault(); // Prevent default to handle manually
        
        try {
          const formData = new FormData(form);
          const mainVariantId = formData.get('id');
          const quantity = parseInt(formData.get('quantity') || '1');
          
          // Generate unique bundle ID for this main+deposit pair
          const bundleId = Date.now().toString();
          
          // First, add the main product with deposit_option and bundle_id properties using AJAX
          const mainResponse = await fetch('/cart/add.js', {
            method: 'POST',
            headers: {
              'Content-Type': 'application/json',
              'X-Requested-With': 'XMLHttpRequest'
            },
            body: JSON.stringify({
              items: [{
                id: parseInt(mainVariantId),
                quantity: quantity,
                properties: {
                  'deposit_option': selectedDepositOption,
                  'bundle_id': bundleId
                }
              }]
            })
          });
          
          if (!mainResponse.ok) {
            throw new Error('Failed to add main product');
          }
          
          // Second, add deposit product using AJAX
          const selectedOption = dropdown.querySelector('option:checked');
          const depositVariantId = selectedOption?.getAttribute('data-variant-id');
          
          if (depositVariantId) {
            const depositAmount = calculateDepositAmount(mainVariantId);
            // Calculate deposit quantity: total deposit amount divided by $100 unit price
            const depositQuantity = Math.ceil(depositAmount / 100) * quantity;
            
            // Get component quantities from metafields for display
            const variantMetafields = window.productMetafields?.[mainVariantId];
            const componentProps = {
              'bundle_id': bundleId,
              '_is_deposit': 'true',
              '_deposit_unit_amount': depositAmount.toFixed(2),
              '_main_product_quantity': quantity
            };
            
            // Add component deposit rates as visible properties (only if component exists)
            if (variantMetafields?.injector_quantity && variantMetafields.injector_quantity > 0) {
              componentProps['Injectors deposit'] = '$100 each';
            }
            if (variantMetafields?.fuel_pump_quantity && variantMetafields.fuel_pump_quantity > 0) {
              componentProps['Fuel pumps deposit'] = '$200 each';
            }
            if (variantMetafields?.fuel_line_quantity && variantMetafields.fuel_line_quantity > 0) {
              componentProps['Fuel lines deposit'] = '$100 each';
            }
            
            const depositResponse = await fetch('/cart/add.js', {
              method: 'POST',
              headers: {
                'Content-Type': 'application/json',
                'X-Requested-With': 'XMLHttpRequest'
              },
              body: JSON.stringify({
                items: [{
                  id: parseInt(depositVariantId),
                  quantity: depositQuantity,
                  properties: componentProps
                }]
              })
            });
            
            if (!depositResponse.ok) {
              console.error('Failed to add deposit product');
            }
          }
          
          // Redirect to cart
          window.location.href = '/cart';
          
        } catch (error) {
          console.error('Error adding products:', error);
          alert('Failed to add products to cart. Please try again.');
        }
      }
      // For 'return_cores_in_advance', let the form submit normally
    });
  });
  
  // Function to calculate deposit amount from main product metafields
  function calculateDepositAmount(mainVariantId) {
    const variantMetafields = window.productMetafields?.[mainVariantId];
    if (!variantMetafields) return 0;
    
    const fuelPumpQuantity = variantMetafields.fuel_pump_quantity || 0;
    const injectorQuantity = variantMetafields.injector_quantity || 0;
    const fuelLineQuantity = variantMetafields.fuel_line_quantity || 0;
    
    // Calculate deposits: injectors × $100, fuel pumps × $200, fuel lines × $100
    const fuelPumpDeposit = fuelPumpQuantity * 200;
    const injectorDeposit = injectorQuantity * 100;
    const fuelLineDeposit = fuelLineQuantity * 100;
    
    return fuelPumpDeposit + injectorDeposit + fuelLineDeposit;
  }

});
</script>
{% else %}
<!-- DEBUG: Product does NOT have has_deposit_options tag -->
<!-- DEBUG: Product ID: {{ product.id }}, Tags: {{ product.tags | join: ', ' }} -->
{% endif %}

{% style %}
  .deposit-variant-picker {
    margin: {{ block.settings.margin_top }}px 0 {{ block.settings.margin_bottom }}px 0;
    padding: {{ block.settings.padding }}px;
    background: {{ block.settings.background_color }};
    border-radius: {{ block.settings.border_radius }}px;
    {% if block.settings.show_border %}
      border: 1px solid {{ block.settings.border_color }};
    {% endif %}
  }

  .deposit-title {
    color: {{ block.settings.title_color }};
    margin-bottom: 12px;
    font-size: {{ block.settings.title_size }}px;
  }

  .deposit-amount-display {
    color: {{ block.settings.text_color }};
    margin-bottom: 16px;
  }

  .deposit-amount {
    color: {{ block.settings.amount_color }};
    font-size: 1.2em;
    font-weight: bold;
  }

  .deposit-options label {
    display: block;
    margin-bottom: 8px;
    color: {{ block.settings.text_color }};
    font-weight: 600;
  }

  .deposit-variant-dropdown {
    width: 100%;
    padding: 12px;
    border: 1px solid {{ block.settings.border_color }};
    border-radius: {{ block.settings.border_radius }}px;
    background: white;
    font-size: 16px;
    color: {{ block.settings.text_color }};
  }

  .deposit-variant-dropdown:focus {
    outline: 2px solid {{ block.settings.accent_color }};
    border-color: {{ block.settings.accent_color }};
  }

  .deposit-variant-dropdown.invalid-selection {
    border-color: #dc2626;
    background-color: #fef2f2;
  }

  .deposit-description {
    margin-top: 12px;
    padding: 12px;
    background: {{ block.settings.description_bg_color }};
    border-radius: {{ block.settings.border_radius }}px;
    color: {{ block.settings.text_color }};
    font-size: 14px;
    line-height: 1.4;
  }

  .deposit-description p {
    margin: 0;
  }

  /* Hide all descriptions by default */
  .description-option {
    display: none;
  }

  /* Show default description initially */
  .description-default {
    display: block;
  }

  /* Show specific descriptions based on dropdown selection */
  .deposit-variant-picker[data-selected="credit_card_on_file"] .description-option[data-option="credit_card_on_file"],
  .deposit-variant-picker[data-selected="pay_core_deposit"] .description-option[data-option="pay_core_deposit"],
  .deposit-variant-picker[data-selected="return_cores_in_advance"] .description-option[data-option="return_cores_in_advance"] {
    display: block;
  }

  /* Hide default when option is selected */
  .deposit-variant-picker[data-selected="credit_card_on_file"] .description-default,
  .deposit-variant-picker[data-selected="pay_core_deposit"] .description-default,
  .deposit-variant-picker[data-selected="return_cores_in_advance"] .description-default {
    display: none;
  }
{% endstyle %}

