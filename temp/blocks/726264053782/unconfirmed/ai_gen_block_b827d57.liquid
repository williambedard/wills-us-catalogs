{% doc %}
  @prompt
    A magazine-style editorial layout

{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-editorial-layout-{{ ai_gen_id }} {
    max-width: 1200px;
    margin: 0 auto;
    padding: {{ block.settings.section_padding }}px;
    background-color: {{ block.settings.background_color }};
  }

  .ai-editorial-grid-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: {{ block.settings.grid_gap }}px;
    align-items: start;
  }

  .ai-editorial-main-article-{{ ai_gen_id }} {
    grid-column: 1 / -1;
    margin-bottom: {{ block.settings.grid_gap }}px;
  }

  .ai-editorial-featured-image-{{ ai_gen_id }} {
    width: 100%;
    margin-bottom: 24px;
    position: relative;
  }

  .ai-editorial-featured-image-{{ ai_gen_id }} img {
    width: 100%;
    height: auto;
    border-radius: {{ block.settings.image_border_radius }}px;
  }

  .ai-editorial-image-placeholder-{{ ai_gen_id }} {
    width: 100%;
    height: 400px;
    background-color: #f4f4f4;
    border-radius: {{ block.settings.image_border_radius }}px;
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
  }

  .ai-editorial-image-placeholder-{{ ai_gen_id }} svg {
    width: 100%;
    height: 100%;
    max-width: 200px;
    max-height: 200px;
  }

  .ai-editorial-empty-state-{{ ai_gen_id }} {
    position: absolute;
    bottom: 20px;
    left: 50%;
    transform: translateX(-50%);
    color: #666;
    font-size: 14px;
    text-align: center;
  }

  .ai-editorial-category-{{ ai_gen_id }} {
    display: inline-block;
    background-color: {{ block.settings.category_background }};
    color: {{ block.settings.category_text_color }};
    padding: 6px 12px;
    border-radius: {{ block.settings.category_border_radius }}px;
    font-size: 12px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    margin-bottom: 16px;
  }

  .ai-editorial-headline-{{ ai_gen_id }} {
    font-size: {{ block.settings.headline_size }}px;
    line-height: 1.2;
    color: {{ block.settings.text_color }};
    margin: 0 0 16px;
    font-weight: 700;
  }

  .ai-editorial-excerpt-{{ ai_gen_id }} {
    font-size: {{ block.settings.excerpt_size }}px;
    line-height: 1.6;
    color: {{ block.settings.text_color }};
    margin-bottom: 20px;
    opacity: 0.8;
  }

  .ai-editorial-meta-{{ ai_gen_id }} {
    display: flex;
    align-items: center;
    gap: 16px;
    font-size: 14px;
    color: {{ block.settings.text_color }};
    opacity: 0.6;
    margin-bottom: 24px;
  }

  .ai-editorial-author-{{ ai_gen_id }} {
    font-weight: 500;
  }

  .ai-editorial-date-{{ ai_gen_id }} {
    position: relative;
  }

  .ai-editorial-date-{{ ai_gen_id }}::before {
    content: "•";
    position: absolute;
    left: -10px;
  }

  .ai-editorial-read-more-{{ ai_gen_id }} {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    color: {{ block.settings.link_color }};
    text-decoration: none;
    font-weight: 500;
    font-size: 14px;
    transition: color 0.3s ease;
  }

  .ai-editorial-read-more-{{ ai_gen_id }}:hover {
    color: {{ block.settings.link_hover_color }};
  }

  .ai-editorial-read-more-{{ ai_gen_id }} svg {
    width: 16px;
    height: 16px;
    transition: transform 0.3s ease;
  }

  .ai-editorial-read-more-{{ ai_gen_id }}:hover svg {
    transform: translateX(4px);
  }

  .ai-editorial-secondary-article-{{ ai_gen_id }} {
    padding: 24px;
    border: 1px solid {{ block.settings.border_color }};
    border-radius: {{ block.settings.card_border_radius }}px;
    background-color: {{ block.settings.card_background }};
  }

  .ai-editorial-secondary-image-{{ ai_gen_id }} {
    width: 100%;
    margin-bottom: 16px;
  }

  .ai-editorial-secondary-image-{{ ai_gen_id }} img {
    width: 100%;
    height: 200px;
    object-fit: cover;
    border-radius: {{ block.settings.image_border_radius }}px;
  }

  .ai-editorial-secondary-image-placeholder-{{ ai_gen_id }} {
    width: 100%;
    height: 200px;
    background-color: #f4f4f4;
    border-radius: {{ block.settings.image_border_radius }}px;
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
  }

  .ai-editorial-secondary-image-placeholder-{{ ai_gen_id }} svg {
    width: 60px;
    height: 60px;
  }

  .ai-editorial-secondary-headline-{{ ai_gen_id }} {
    font-size: {{ block.settings.secondary_headline_size }}px;
    line-height: 1.3;
    color: {{ block.settings.text_color }};
    margin: 0 0 12px;
    font-weight: 600;
  }

  .ai-editorial-secondary-excerpt-{{ ai_gen_id }} {
    font-size: {{ block.settings.secondary_excerpt_size }}px;
    line-height: 1.5;
    color: {{ block.settings.text_color }};
    opacity: 0.8;
    margin-bottom: 16px;
  }

  .ai-editorial-secondary-meta-{{ ai_gen_id }} {
    font-size: 12px;
    color: {{ block.settings.text_color }};
    opacity: 0.6;
    margin-bottom: 12px;
  }

  @media screen and (max-width: 768px) {
    .ai-editorial-layout-{{ ai_gen_id }} {
      padding: {{ block.settings.section_padding | times: 0.6 }}px;
    }

    .ai-editorial-grid-{{ ai_gen_id }} {
      grid-template-columns: 1fr;
      gap: {{ block.settings.grid_gap | times: 0.8 }}px;
    }

    .ai-editorial-headline-{{ ai_gen_id }} {
      font-size: {{ block.settings.headline_size | times: 0.8 }}px;
    }

    .ai-editorial-secondary-article-{{ ai_gen_id }} {
      padding: 20px;
    }

    .ai-editorial-meta-{{ ai_gen_id }} {
      flex-direction: column;
      align-items: flex-start;
      gap: 8px;
    }

    .ai-editorial-date-{{ ai_gen_id }}::before {
      display: none;
    }
  }
{% endstyle %}

<div class="ai-editorial-layout-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-editorial-grid-{{ ai_gen_id }}">
    <article class="ai-editorial-main-article-{{ ai_gen_id }}">
      <div class="ai-editorial-featured-image-{{ ai_gen_id }}">
        {% if block.settings.featured_image %}
          <img
            src="{{ block.settings.featured_image | image_url: width: 1200 }}"
            alt="{{ block.settings.featured_image.alt | escape }}"
            loading="lazy"
            width="{{ block.settings.featured_image.width }}"
            height="{{ block.settings.featured_image.height }}"
          >
        {% else %}
          <div class="ai-editorial-image-placeholder-{{ ai_gen_id }}">
            {{ 'hero-apparel-1' | placeholder_svg_tag }}
            <div class="ai-editorial-empty-state-{{ ai_gen_id }}">
              Add a featured image
            </div>
          </div>
        {% endif %}
      </div>

      {% if block.settings.featured_category != blank %}
        <span class="ai-editorial-category-{{ ai_gen_id }}">{{ block.settings.featured_category }}</span>
      {% endif %}

      {% if block.settings.featured_headline != blank %}
        <h1 class="ai-editorial-headline-{{ ai_gen_id }}">{{ block.settings.featured_headline }}</h1>
      {% endif %}

      {% if block.settings.featured_excerpt != blank %}
        <div class="ai-editorial-excerpt-{{ ai_gen_id }}">{{ block.settings.featured_excerpt }}</div>
      {% endif %}

      <div class="ai-editorial-meta-{{ ai_gen_id }}">
        {% if block.settings.featured_author != blank %}
          <span class="ai-editorial-author-{{ ai_gen_id }}">By {{ block.settings.featured_author }}</span>
        {% endif %}
        {% if block.settings.featured_date != blank %}
          <span class="ai-editorial-date-{{ ai_gen_id }}">{{ block.settings.featured_date }}</span>
        {% endif %}
      </div>

      {% if block.settings.featured_link != blank %}
        <a href="{{ block.settings.featured_link }}" class="ai-editorial-read-more-{{ ai_gen_id }}">
          Read full article
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <line x1="7" y1="17" x2="17" y2="7"></line>
            <polyline points="7,7 17,7 17,17"></polyline>
          </svg>
        </a>
      {% endif %}
    </article>

    <article class="ai-editorial-secondary-article-{{ ai_gen_id }}">
      <div class="ai-editorial-secondary-image-{{ ai_gen_id }}">
        {% if block.settings.secondary_image_1 %}
          <img
            src="{{ block.settings.secondary_image_1 | image_url: width: 400 }}"
            alt="{{ block.settings.secondary_image_1.alt | escape }}"
            loading="lazy"
            width="{{ block.settings.secondary_image_1.width }}"
            height="{{ block.settings.secondary_image_1.height }}"
          >
        {% else %}
          <div class="ai-editorial-secondary-image-placeholder-{{ ai_gen_id }}">
            {{ 'image' | placeholder_svg_tag }}
          </div>
        {% endif %}
      </div>

      {% if block.settings.secondary_category_1 != blank %}
        <div class="ai-editorial-secondary-meta-{{ ai_gen_id }}">{{ block.settings.secondary_category_1 }}</div>
      {% endif %}

      {% if block.settings.secondary_headline_1 != blank %}
        <h2 class="ai-editorial-secondary-headline-{{ ai_gen_id }}">{{ block.settings.secondary_headline_1 }}</h2>
      {% endif %}

      {% if block.settings.secondary_excerpt_1 != blank %}
        <div class="ai-editorial-secondary-excerpt-{{ ai_gen_id }}">{{ block.settings.secondary_excerpt_1 }}</div>
      {% endif %}

      {% if block.settings.secondary_link_1 != blank %}
        <a href="{{ block.settings.secondary_link_1 }}" class="ai-editorial-read-more-{{ ai_gen_id }}">
          Read more
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <line x1="7" y1="17" x2="17" y2="7"></line>
            <polyline points="7,7 17,7 17,17"></polyline>
          </svg>
        </a>
      {% endif %}
    </article>

    <article class="ai-editorial-secondary-article-{{ ai_gen_id }}">
      <div class="ai-editorial-secondary-image-{{ ai_gen_id }}">
        {% if block.settings.secondary_image_2 %}
          <img
            src="{{ block.settings.secondary_image_2 | image_url: width: 400 }}"
            alt="{{ block.settings.secondary_image_2.alt | escape }}"
            loading="lazy"
            width="{{ block.settings.secondary_image_2.width }}"
            height="{{ block.settings.secondary_image_2.height }}"
          >
        {% else %}
          <div class="ai-editorial-secondary-image-placeholder-{{ ai_gen_id }}">
            {{ 'image' | placeholder_svg_tag }}
          </div>
        {% endif %}
      </div>

      {% if block.settings.secondary_category_2 != blank %}
        <div class="ai-editorial-secondary-meta-{{ ai_gen_id }}">{{ block.settings.secondary_category_2 }}</div>
      {% endif %}

      {% if block.settings.secondary_headline_2 != blank %}
        <h2 class="ai-editorial-secondary-headline-{{ ai_gen_id }}">{{ block.settings.secondary_headline_2 }}</h2>
      {% endif %}

      {% if block.settings.secondary_excerpt_2 != blank %}
        <div class="ai-editorial-secondary-excerpt-{{ ai_gen_id }}">{{ block.settings.secondary_excerpt_2 }}</div>
      {% endif %}

      {% if block.settings.secondary_link_2 != blank %}
        <a href="{{ block.settings.secondary_link_2 }}" class="ai-editorial-read-more-{{ ai_gen_id }}">
          Read more
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <line x1="7" y1="17" x2="17" y2="7"></line>
            <polyline points="7,7 17,7 17,17"></polyline>
          </svg>
        </a>
      {% endif %}
    </article>
  </div>
</div>

{% schema %}
{
  "name": "Magazine editorial layout",
  "settings": [
    {
      "type": "header",
      "content": "Featured article"
    },
    {
      "type": "image_picker",
      "id": "featured_image",
      "label": "Featured image"
    },
    {
      "type": "text",
      "id": "featured_category",
      "label": "Category",
      "default": "Featured"
    },
    {
      "type": "text",
      "id": "featured_headline",
      "label": "Headline",
      "default": "The Future of Sustainable Fashion"
    },
    {
      "type": "textarea",
      "id": "featured_excerpt",
      "label": "Excerpt",
      "default": "Discover how innovative designers are revolutionizing the fashion industry with eco-friendly materials and ethical production practices."
    },
    {
      "type": "text",
      "id": "featured_author",
      "label": "Author",
      "default": "Sarah Johnson"
    },
    {
      "type": "text",
      "id": "featured_date",
      "label": "Date",
      "default": "March 15, 2024"
    },
    {
      "type": "url",
      "id": "featured_link",
      "label": "Article link"
    },
    {
      "type": "header",
      "content": "Secondary article 1"
    },
    {
      "type": "image_picker",
      "id": "secondary_image_1",
      "label": "Image"
    },
    {
      "type": "text",
      "id": "secondary_category_1",
      "label": "Category",
      "default": "Style"
    },
    {
      "type": "text",
      "id": "secondary_headline_1",
      "label": "Headline",
      "default": "Spring Collection Highlights"
    },
    {
      "type": "textarea",
      "id": "secondary_excerpt_1",
      "label": "Excerpt",
      "default": "Explore the season's must-have pieces and trending colors."
    },
    {
      "type": "url",
      "id": "secondary_link_1",
      "label": "Article link"
    },
    {
      "type": "header",
      "content": "Secondary article 2"
    },
    {
      "type": "image_picker",
      "id": "secondary_image_2",
      "label": "Image"
    },
    {
      "type": "text",
      "id": "secondary_category_2",
      "label": "Category",
      "default": "Trends"
    },
    {
      "type": "text",
      "id": "secondary_headline_2",
      "label": "Headline",
      "default": "Minimalist Design Philosophy"
    },
    {
      "type": "textarea",
      "id": "secondary_excerpt_2",
      "label": "Excerpt",
      "default": "How less is more in contemporary fashion design."
    },
    {
      "type": "url",
      "id": "secondary_link_2",
      "label": "Article link"
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "link_color",
      "label": "Link",
      "default": "#000f9f"
    },
    {
      "type": "color",
      "id": "link_hover_color",
      "label": "Link hover",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "category_background",
      "label": "Category background",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "category_text_color",
      "label": "Category text",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "card_background",
      "label": "Card background",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "border_color",
      "label": "Border",
      "default": "#e6e6e6"
    },
    {
      "type": "header",
      "content": "Typography"
    },
    {
      "type": "range",
      "id": "headline_size",
      "min": 24,
      "max": 72,
      "step": 2,
      "unit": "px",
      "label": "Featured headline size",
      "default": 48
    },
    {
      "type": "range",
      "id": "excerpt_size",
      "min": 14,
      "max": 24,
      "step": 1,
      "unit": "px",
      "label": "Featured excerpt size",
      "default": 18
    },
    {
      "type": "range",
      "id": "secondary_headline_size",
      "min": 16,
      "max": 32,
      "step": 1,
      "unit": "px",
      "label": "Secondary headline size",
      "default": 20
    },
    {
      "type": "range",
      "id": "secondary_excerpt_size",
      "min": 12,
      "max": 18,
      "step": 1,
      "unit": "px",
      "label": "Secondary excerpt size",
      "default": 14
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "section_padding",
      "min": 20,
      "max": 80,
      "step": 4,
      "unit": "px",
      "label": "Section padding",
      "default": 40
    },
    {
      "type": "range",
      "id": "grid_gap",
      "min": 16,
      "max": 48,
      "step": 4,
      "unit": "px",
      "label": "Grid gap",
      "default": 32
    },
    {
      "type": "range",
      "id": "image_border_radius",
      "min": 0,
      "max": 20,
      "step": 2,
      "unit": "px",
      "label": "Image border radius",
      "default": 8
    },
    {
      "type": "range",
      "id": "card_border_radius",
      "min": 0,
      "max": 20,
      "step": 2,
      "unit": "px",
      "label": "Card border radius",
      "default": 12
    },
    {
      "type": "range",
      "id": "category_border_radius",
      "min": 0,
      "max": 20,
      "step": 2,
      "unit": "px",
      "label": "Category border radius",
      "default": 20
    }
  ],
  "presets": [
    {
      "name": "Magazine editorial layout"
    }
  ],
  "tag": null
}
{% endschema %}