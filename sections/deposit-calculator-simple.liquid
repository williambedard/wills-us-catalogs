{%- comment -%}
Ultra Simple Deposit Calculator
Uses MONEY metafields directly - no calculations
Updates deposit product prices on page load based on first available variant
{%- endcomment -%}

<script src="{{ 'deposit-ultra-simple.js' | asset_url }}" defer></script>

{% liquid
  assign product = product | default: closest.product
  assign first_variant = product.selected_or_first_available_variant
%}

{% comment %} Expose product metafields to JavaScript {% endcomment %}
<script>
  window.productMetafields = window.productMetafields || {};
  {% for variant in product.variants %}
    window.productMetafields["{{ variant.id }}"] = {
      "fuel_pump_deposit": {{ variant.metafields.custom.deposit_for_high_pressure_fuel_pumps.value | default: 0 }},
      "injector_deposit": {{ variant.metafields.custom.deposit_for_injectors.value | default: 0 }},
      "fuel_line_deposit": {{ variant.metafields.custom.deposit_for_fuel_lines.value | default: 0 }}
    };
  {% endfor %}
</script>

{% comment %} Calculate initial deposit for first variant {% endcomment %}
{% liquid
  assign initial_deposit = 0
  if first_variant.metafields.custom.deposit_for_high_pressure_fuel_pumps.value
    assign initial_deposit = initial_deposit | plus: first_variant.metafields.custom.deposit_for_high_pressure_fuel_pumps.value
  endif
  if first_variant.metafields.custom.deposit_for_injectors.value  
    assign initial_deposit = initial_deposit | plus: first_variant.metafields.custom.deposit_for_injectors.value
  endif
  if first_variant.metafields.custom.deposit_for_fuel_lines.value
    assign initial_deposit = initial_deposit | plus: first_variant.metafields.custom.deposit_for_fuel_lines.value
  endif
%}

{% comment %} Update deposit product prices on page load {% endcomment %}
{% if initial_deposit > 0 %}
  {% liquid
    assign deposit_product = all_products['refundable-core-deposit']
    for variant in deposit_product.variants
      case variant.title
        when 'Credit card on file'
          comment
          # Would update variant price to initial_deposit here if we had API access
          # For now, Cart Transform Function will handle this
          endcomment
        when 'Pay core deposit upfront'  
          comment
          # Would update variant price to initial_deposit here if we had API access
          # For now, Cart Transform Function will handle this
          endcomment
      endcase
    endfor
  %}
{% endif %}

<div class="deposit-calculator" {% if initial_deposit == 0 %}style="display: none;"{% endif %}>
  
  {% if section.settings.show_deposit_info %}
  <div class="deposit-info">
    <h3>{{ section.settings.deposit_title }}</h3>
    <p class="deposit-amount-text">
      {{ section.settings.deposit_description }}: 
      <strong class="deposit-amount">${{ initial_deposit | money_without_currency }}</strong>
    </p>
  </div>
  {% endif %}

  <div class="payment-options">
    <h4>{{ section.settings.options_title }}</h4>
    
    <div class="option-group">
      <input type="radio" id="cc_hold" name="payment_option" value="credit_card_on_file" {% if initial_deposit > 0 %}checked{% endif %}>
      <label for="cc_hold">
        <strong>{{ section.settings.option1_title }}</strong>
        <span class="option-description">{{ section.settings.option1_description }} $<span class="deposit-total">{{ initial_deposit | money_without_currency }}</span></span>
      </label>
    </div>

    <div class="option-group">
      <input type="radio" id="pay_now" name="payment_option" value="pay_deposit">
      <label for="pay_now">
        <strong>{{ section.settings.option2_title }}</strong>
        <span class="option-description">{{ section.settings.option2_description }} $<span class="deposit-total">{{ initial_deposit | money_without_currency }}</span></span>
      </label>
    </div>

    <div class="option-group">
      <input type="radio" id="return_first" name="payment_option" value="return_first">
      <label for="return_first">
        <strong>{{ section.settings.option3_title }}</strong>
        <span class="option-description">{{ section.settings.option3_description }}</span>
      </label>
    </div>
  </div>

</div>

{% style %}
  .deposit-calculator {
    margin: {{ section.settings.margin_top }}px 0 {{ section.settings.margin_bottom }}px 0;
    padding: {{ section.settings.padding }}px;
    background: {{ section.settings.background_color }};
    border-radius: {{ section.settings.border_radius }}px;
    {% if section.settings.show_border %}
      border: 1px solid {{ section.settings.border_color }};
    {% endif %}
  }

  .deposit-info h3 {
    color: {{ section.settings.title_color }};
    margin-bottom: 8px;
  }

  .deposit-amount-text {
    color: {{ section.settings.text_color }};
    margin-bottom: 16px;
  }

  .deposit-amount {
    color: {{ section.settings.amount_color }};
    font-size: 1.2em;
  }

  .payment-options h4 {
    color: {{ section.settings.title_color }};
    margin-bottom: 12px;
  }

  .option-group {
    margin-bottom: 12px;
    padding: 12px;
    border: 1px solid #e0e0e0;
    border-radius: 6px;
    cursor: pointer;
  }

  .option-group:hover {
    background-color: #f8f8f8;
  }

  .option-group input[type="radio"] {
    margin-right: 8px;
  }

  .option-group label {
    cursor: pointer;
    display: block;
  }

  .option-description {
    display: block;
    font-size: 0.9em;
    color: #666;
    margin-top: 4px;
  }

  .deposit-total {
    font-weight: bold;
    color: {{ section.settings.amount_color }};
  }
{% endstyle %}

{% schema %}
{
  "name": "Deposit Calculator (Simple)",
  "tag": "section",
  "class": "section-deposit-calculator",
  "settings": [
    {
      "type": "header",
      "content": "Display Settings"
    },
    {
      "type": "checkbox",
      "id": "show_deposit_info",
      "label": "Show deposit information",
      "default": true
    },
    {
      "type": "text",
      "id": "deposit_title",
      "label": "Deposit section title",
      "default": "Core Deposit Required"
    },
    {
      "type": "text", 
      "id": "deposit_description",
      "label": "Deposit description",
      "default": "Core Deposit"
    },
    {
      "type": "text",
      "id": "options_title", 
      "label": "Payment options title",
      "default": "Choose your deposit option:"
    },
    {
      "type": "header",
      "content": "Payment Options"
    },
    {
      "type": "text",
      "id": "option1_title",
      "label": "Option 1 Title",
      "default": "Credit Card Hold"
    },
    {
      "type": "text",
      "id": "option1_description", 
      "label": "Option 1 Description",
      "default": "We'll hold"
    },
    {
      "type": "text",
      "id": "option2_title",
      "label": "Option 2 Title", 
      "default": "Pay Now"
    },
    {
      "type": "text",
      "id": "option2_description",
      "label": "Option 2 Description",
      "default": "Pay deposit of"
    },
    {
      "type": "text",
      "id": "option3_title",
      "label": "Option 3 Title",
      "default": "Return Cores First"  
    },
    {
      "type": "text",
      "id": "option3_description",
      "label": "Option 3 Description",
      "default": "No deposit required - return your old cores first"
    },
    {
      "type": "header",
      "content": "Styling"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background Color",
      "default": "#f9f9f9"
    },
    {
      "type": "color",
      "id": "title_color", 
      "label": "Title Color",
      "default": "#333333"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color", 
      "default": "#666666"
    },
    {
      "type": "color",
      "id": "amount_color",
      "label": "Amount Color",
      "default": "#d73502"
    },
    {
      "type": "checkbox",
      "id": "show_border",
      "label": "Show border",
      "default": true
    },
    {
      "type": "color",
      "id": "border_color",
      "label": "Border Color",
      "default": "#e0e0e0"
    },
    {
      "type": "range",
      "id": "border_radius",
      "label": "Border Radius",
      "min": 0,
      "max": 20,
      "step": 1,
      "default": 8
    },
    {
      "type": "range",
      "id": "padding",
      "label": "Padding",
      "min": 10,
      "max": 50,
      "step": 5,
      "default": 20
    },
    {
      "type": "range",
      "id": "margin_top",
      "label": "Margin Top",
      "min": 0,
      "max": 50,
      "step": 5,
      "default": 20
    },
    {
      "type": "range", 
      "id": "margin_bottom",
      "label": "Margin Bottom",
      "min": 0,
      "max": 50, 
      "step": 5,
      "default": 20
    }
  ],
  "presets": [
    {
      "name": "Deposit Calculator (Simple)"
    }
  ]
}
{% endschema %}