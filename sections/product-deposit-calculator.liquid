{%- doc -%}
  Renders the product deposit calculator component that calculates and displays
  core deposit pricing based on product variant metafields.

  @param {object} closest - The closest product object.
{%- enddoc -%}

<script src="{{ 'deposit-calculator.js' | asset_url }}" type="module"></script>

{% liquid
  assign product = closest.product
  if request.visual_preview_mode and product == blank
    assign product = collections.all.products.first
  endif
  
  assign deposit_product = all_products['refundable-core-deposit']
  assign credit_card_variant = deposit_product.variants | where: 'title', 'Credit card on file' | first
  assign pay_deposit_variant = deposit_product.variants | where: 'title', 'Pay core deposit upfront' | first
  assign return_first_variant = deposit_product.variants | where: 'title', 'Return cores in advance' | first
%}

<!-- Expose product data to JavaScript -->
<script>
  window.productData = {{ product | json }};
  window.productMetafields = {
    {% for variant in product.variants %}
      "{{ variant.id }}": {
        "injectors": {{ variant.metafields.custom.number_of_injectors | default: 0 }},
        "fuel_lines": {{ variant.metafields.custom.number_of_fuel_lines | default: 0 }},
        "fuel_pumps": {{ variant.metafields.custom.number_of_high_pressure_fuel_pumps_for_deposit | default: 0 }}
      }{% unless forloop.last %},{% endunless %}
    {% endfor %}
  };
  
  window.depositProductConfig = {
    handle: 'refundable-core-deposit',
    productId: '{{ deposit_product.id }}',
    variants: {
      creditCard: {
        id: '{{ credit_card_variant.id }}',
        title: '{{ credit_card_variant.title }}',
        price: {{ credit_card_variant.price | money_without_currency | remove: ',' }}
      },
      payDeposit: {
        id: '{{ pay_deposit_variant.id }}',
        title: '{{ pay_deposit_variant.title }}',
        price: {{ pay_deposit_variant.price | money_without_currency | remove: ',' }}
      },
      returnFirst: {
        id: '{{ return_first_variant.id }}',
        title: '{{ return_first_variant.title }}',
        price: {{ return_first_variant.price | money_without_currency | remove: ',' }}
      }
    }
  };
  
  window.Theme = window.Theme || {};
  window.Theme.routes = {
    cart_add_url: '{{ routes.cart_add_url }}',
    cart_update_url: '{{ routes.cart_update_url }}',
    cart_url: '{{ routes.cart_url }}'
  };
</script>

<deposit-calculator 
  class="deposit-calculator spacing-style"
  data-product-id="{{ product.id }}"
  data-section-id="{{ section.id }}"
  style="{% render 'spacing-style', settings: section.settings %}"
>
  <!-- Deposit Amount Display -->
  <div 
    class="deposit-display hidden"
    ref="depositDisplay"
  >
    <div class="deposit-info">
      <span class="deposit-label">{{ section.settings.deposit_label | default: 'Core Deposit:' }}</span>
      <span 
        class="deposit-value" 
        ref="depositAmount"
      >$0.00</span>
    </div>
  </div>

  <!-- Payment Options -->
  <div 
    class="payment-options hidden"
    ref="paymentOptions"
  >
    <fieldset class="payment-options__fieldset">
      <legend class="payment-options__legend">{{ section.settings.payment_options_label | default: 'Choose your deposit option:' }}</legend>
      
      <div class="payment-option">
        <input 
          type="radio" 
          name="payment_option" 
          value="credit_card_on_file" 
          id="cc_hold_{{ section.id }}"
          class="payment-option__input"
        >
        <label 
          for="cc_hold_{{ section.id }}" 
          class="payment-option__label"
        >
          <span class="payment-option__title">{{ section.settings.credit_card_option_label | default: 'Credit Card On File' }}</span>
          <span class="payment-option__description">
            {{ section.settings.credit_card_option_description | default: 'Hold: $' }}<span class="deposit-total">0</span>
          </span>
        </label>
      </div>

      <div class="payment-option">
        <input 
          type="radio" 
          name="payment_option" 
          value="pay_deposit" 
          id="pay_now_{{ section.id }}"
          class="payment-option__input"
        >
        <label 
          for="pay_now_{{ section.id }}" 
          class="payment-option__label"
        >
          <span class="payment-option__title">{{ section.settings.pay_deposit_option_label | default: 'Pay Core Deposit' }}</span>
          <span class="payment-option__description">
            {{ section.settings.pay_deposit_option_description | default: 'Charge: $' }}<span class="deposit-total">0</span>
          </span>
        </label>
      </div>

      <div class="payment-option">
        <input 
          type="radio" 
          name="payment_option" 
          value="return_first" 
          id="return_first_{{ section.id }}"
          class="payment-option__input"
        >
        <label 
          for="return_first_{{ section.id }}" 
          class="payment-option__label"
        >
          <span class="payment-option__title">{{ section.settings.return_first_option_label | default: 'Return Cores in Advance' }}</span>
          <span class="payment-option__description">{{ section.settings.return_first_option_description | default: 'No deposit required' }}</span>
        </label>
      </div>
    </fieldset>
  </div>

  <!-- Error Display -->
  <div 
    class="deposit-error hidden" 
    ref="errorDisplay"
  >
    <span class="deposit-error__icon">
      <span class="svg-wrapper">
        {{- 'icon-error.svg' | inline_asset_content -}}
      </span>
    </span>
    <span class="error-message">Unable to calculate deposit</span>
  </div>
</deposit-calculator>

{% stylesheet %}
  .deposit-calculator {
    width: 100%;
  }

  .deposit-display {
    margin-bottom: var(--padding-md);
    padding: var(--padding-md);
    background-color: var(--color-background-secondary);
    border-radius: var(--style-border-radius-cards);
    border: 1px solid var(--color-border);
  }

  .deposit-display.calculating {
    opacity: 0.6;
  }

  .deposit-info {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .deposit-label {
    font-weight: 600;
    color: var(--color-foreground);
  }

  .deposit-value {
    font-size: var(--font-size--lg);
    font-weight: 700;
    color: var(--color-primary);
  }

  .payment-options {
    margin-bottom: var(--padding-md);
  }

  .payment-options.calculating {
    opacity: 0.6;
    pointer-events: none;
  }

  .payment-options__fieldset {
    border: none;
    margin: 0;
    padding: 0;
  }

  .payment-options__legend {
    font-weight: 600;
    margin-bottom: var(--padding-sm);
    color: var(--color-foreground);
  }

  .payment-option {
    margin-bottom: var(--padding-sm);
    border: 1px solid var(--color-border);
    border-radius: var(--style-border-radius-buttons-primary);
    overflow: hidden;
    transition: all 0.2s ease;
  }

  .payment-option:hover {
    border-color: var(--color-primary);
  }

  .payment-option:has(.payment-option__input:checked) {
    border-color: var(--color-primary);
    background-color: var(--color-primary-background);
  }

  .payment-option__input {
    position: absolute;
    opacity: 0;
    pointer-events: none;
  }

  .payment-option__label {
    display: flex;
    flex-direction: column;
    padding: var(--padding-md);
    cursor: pointer;
    position: relative;
  }

  .payment-option__label::before {
    content: '';
    position: absolute;
    top: var(--padding-md);
    right: var(--padding-md);
    width: 20px;
    height: 20px;
    border: 2px solid var(--color-border);
    border-radius: 50%;
    background-color: var(--color-background);
    transition: all 0.2s ease;
  }

  .payment-option__input:checked + .payment-option__label::before {
    border-color: var(--color-primary);
    background-color: var(--color-primary);
  }

  .payment-option__input:checked + .payment-option__label::after {
    content: '';
    position: absolute;
    top: calc(var(--padding-md) + 6px);
    right: calc(var(--padding-md) + 6px);
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background-color: var(--color-background);
  }

  .payment-option__title {
    font-weight: 600;
    margin-bottom: var(--padding-xs);
    margin-right: var(--padding-lg);
    color: var(--color-foreground);
  }

  .payment-option__description {
    font-size: var(--font-size--sm);
    color: var(--color-foreground-secondary);
  }

  .deposit-total {
    font-weight: 600;
    color: var(--color-primary);
  }

  .deposit-error {
    display: flex;
    align-items: center;
    gap: var(--gap-xs);
    padding: var(--padding-md);
    background-color: var(--color-error-background);
    border: 1px solid var(--color-error);
    border-radius: var(--style-border-radius-cards);
    color: var(--color-error);
  }

  .deposit-error__icon {
    flex-shrink: 0;
  }

  .hidden {
    display: none !important;
  }

  /* Responsive adjustments */
  @media screen and (max-width: 749px) {
    .payment-option__label {
      padding: var(--padding-sm);
    }
    
    .payment-option__label::before {
      top: var(--padding-sm);
      right: var(--padding-sm);
    }
    
    .payment-option__input:checked + .payment-option__label::after {
      top: calc(var(--padding-sm) + 6px);
      right: calc(var(--padding-sm) + 6px);
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Product Deposit Calculator",
  "tag": "div",
  "settings": [
    {
      "type": "paragraph",
      "content": "Displays core deposit calculation and payment options based on product variant metafields."
    },
    {
      "type": "text",
      "id": "deposit_label",
      "label": "Deposit label",
      "default": "Core Deposit:"
    },
    {
      "type": "text",
      "id": "payment_options_label",
      "label": "Payment options label",
      "default": "Choose your deposit option:"
    },
    {
      "type": "header",
      "content": "Credit Card Option"
    },
    {
      "type": "text",
      "id": "credit_card_option_label",
      "label": "Credit card option label",
      "default": "Credit Card On File"
    },
    {
      "type": "text",
      "id": "credit_card_option_description",
      "label": "Credit card option description",
      "default": "Hold: $"
    },
    {
      "type": "header",
      "content": "Pay Deposit Option"
    },
    {
      "type": "text",
      "id": "pay_deposit_option_label",
      "label": "Pay deposit option label",
      "default": "Pay Core Deposit"
    },
    {
      "type": "text",
      "id": "pay_deposit_option_description",
      "label": "Pay deposit option description",
      "default": "Charge: $"
    },
    {
      "type": "header",
      "content": "Return First Option"
    },
    {
      "type": "text",
      "id": "return_first_option_label",
      "label": "Return first option label",
      "default": "Return Cores in Advance"
    },
    {
      "type": "text",
      "id": "return_first_option_description",
      "label": "Return first option description",
      "default": "No deposit required"
    },
    {
      "type": "header",
      "content": "t:content.padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "t:settings.top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "t:settings.bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    }
  ],
  "presets": [
    {
      "name": "Product Deposit Calculator",
      "category": "Product"
    }
  ]
}
{% endschema %}