{%- doc -%}
  Renders the cart deposit manager component that ensures consistency
  between main products and their associated deposit products.

  This component handles:
  - Quantity synchronization (deposits always quantity 1)
  - Orphaned deposit removal
  - Missing deposit addition
  - Cart state validation
{%- enddoc -%}

<!-- Cart deposit handler temporarily disabled for cleanup -->

{% comment %}
  Expose necessary configuration to JavaScript
{% endcomment %}
<script>
  window.Theme = window.Theme || {};
  window.Theme.routes = window.Theme.routes || {};
  Object.assign(window.Theme.routes, {
    cart_add_url: '{{ routes.cart_add_url }}',
    cart_update_url: '{{ routes.cart_update_url }}',
    cart_url: '{{ routes.cart_url }}'
  });

  {% assign deposit_product = all_products['refundable-core-deposit'] %}
  {% if deposit_product %}
    // DEBUG: Deposit product found
    console.log('✅ Deposit product found:', '{{ deposit_product.title }}', 'ID:', '{{ deposit_product.id }}');
    {% assign credit_card_variant = deposit_product.variants | where: 'title', 'Credit Card on File' | first %}
    {% assign pay_deposit_variant = deposit_product.variants | where: 'title', 'Pay Core Deposit' | first %}
    {% assign return_first_variant = deposit_product.variants | where: 'title', 'Return Cores in Advance' | first %}
    
    // DEBUG: Check which variants were found
    console.log('Deposit variants found:', {
      creditCard: '{{ credit_card_variant.title | default: "NOT FOUND" }}',
      payDeposit: '{{ pay_deposit_variant.title | default: "NOT FOUND" }}', 
      returnFirst: '{{ return_first_variant.title | default: "NOT FOUND" }}'
    });
    
    // DEBUG: Show all available variant titles for reference
    console.log('All available variant titles:', [
      {% for variant in deposit_product.variants %}'{{ variant.title }}'{% unless forloop.last %},{% endunless %}{% endfor %}
    ]);
    
    window.depositProductConfig = window.depositProductConfig || {};
    Object.assign(window.depositProductConfig, {
      handle: 'refundable-core-deposit',
      productId: '{{ deposit_product.id }}',
      variants: {
        creditCard: {
          id: '{{ credit_card_variant.id | default: "" }}',
          title: '{{ credit_card_variant.title | default: "" }}',
          price: {{ credit_card_variant.price | money_without_currency | remove: ',' | default: 0 }}
        },
        payDeposit: {
          id: '{{ pay_deposit_variant.id | default: "" }}',
          title: '{{ pay_deposit_variant.title | default: "" }}',
          price: {{ pay_deposit_variant.price | money_without_currency | remove: ',' | default: 0 }}
        },
        returnFirst: {
          id: '{{ return_first_variant.id | default: "" }}',
          title: '{{ return_first_variant.title | default: "" }}',
          price: {{ return_first_variant.price | money_without_currency | remove: ',' | default: 0 }}
        }
      }
    });
    
    // DEBUG: Final deposit product config
    console.log('💰 Deposit product config loaded:', window.depositProductConfig);
    
    // DEBUG: Log cart items and their properties on cart page
    fetch('/cart.js')
      .then(response => response.json())
      .then(cart => {
        console.log('📦 CART ITEMS WITH PROPERTIES:');
        cart.items.forEach((item, index) => {
          console.log(`[CART-ITEM-${index + 1}] ${item.product_title} (${item.variant_title || 'Default'}):`, {
            variant_id: item.variant_id,
            quantity: item.quantity,
            properties: item.properties || {},
            key: item.key,
            price: item.price
          });
        });
      })
      .catch(err => console.error('Failed to fetch cart:', err));
  {% else %}
    // Deposit product not found - create empty config
    console.error('❌ Deposit product "refundable-core-deposit" not found in store');
    window.depositProductConfig = window.depositProductConfig || {};
    Object.assign(window.depositProductConfig, {
      handle: 'refundable-core-deposit',
      productId: '',
      variants: {
        creditCard: { id: '', title: '', price: 0 },
        payDeposit: { id: '', title: '', price: 0 },
        returnFirst: { id: '', title: '', price: 0 }
      }
    });
  {% endif %}
</script>

{% stylesheet %}
  .cart-deposit-manager {
    /* Hidden component - no visual styles needed */
    position: absolute;
    opacity: 0;
    pointer-events: none;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Cart Deposit Handler",
  "tag": "div",
  "settings": [
    {
      "type": "paragraph",
      "content": "Manages deposit product consistency in the cart. This is a background component with no visible UI."
    }
  ],
  "presets": [
    {
      "name": "Cart Deposit Handler",
      "category": "Cart"
    }
  ]
}
{% endschema %}